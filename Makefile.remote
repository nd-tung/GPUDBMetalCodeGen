# GPU Database Metal CodeGen Remote Makefile
# Usage: make -f Makefile.remote <target>

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
PROJECT_NAME = GPUDBCodegen
CODEGEN_DIR  = codegen
BUILD_DIR    = build
BIN_DIR      = $(BUILD_DIR)/bin
OBJ_DIR      = $(BUILD_DIR)/obj

CXX      = clang++
CXXFLAGS = -std=c++20 -Wall -Wextra -O3 -MMD -MP
INCLUDES = -Ithird_party/metal-cpp -Ithird_party/libpg_query \
           -Icodegen -Icodegen/core -Icodegen/operators -Icodegen/execution -Icodegen/planning
FRAMEWORKS = -framework Metal -framework Foundation -framework QuartzCore \
             -L/opt/homebrew/opt/llvm/lib/c++ -Wl,-rpath,/opt/homebrew/opt/llvm/lib/c++

CODEGEN_SUBDIRS = core operators execution planning
CODEGEN_SUB_SOURCES = $(shell find $(addprefix $(CODEGEN_DIR)/,$(CODEGEN_SUBDIRS)) -name '*.cpp' -type f | sort)
CODEGEN_LIB_OBJECTS = $(patsubst $(CODEGEN_DIR)/%.cpp,$(OBJ_DIR)/codegen_%.o,$(CODEGEN_SUB_SOURCES))
CODEGEN_MAIN_OBJ    = $(OBJ_DIR)/codegen_codegen_main.o

INFRA_OBJ = $(OBJ_DIR)/codegen_core/infra.o

PG_QUERY_DIR = third_party/libpg_query
PG_QUERY_LIB = $(PG_QUERY_DIR)/libpg_query.a

TARGET = $(BIN_DIR)/$(PROJECT_NAME)

TBL2COLBIN_SRC = tools/tbl_to_colbin.cpp
TBL2COLBIN_OBJ = $(OBJ_DIR)/tbl_to_colbin.o
TBL2COLBIN     = $(BIN_DIR)/tbl_to_colbin

QUERIES = q1 q2 q3 q4 q5 q6 q7 q8 q9 q10 q11 q12 q13 q14 q15 q16 q17 q18 q19 q20 q21 q22

# ---------------------------------------------------------------------------
# Remote host
# ---------------------------------------------------------------------------
REMOTE_USER = nguyen
REMOTE_HOST = macsimilian
REMOTE_PATH = /Users/nguyen/Documents/GPUDBMetalCodeGen

REMOTE = $(REMOTE_HOST)
SSH    = ssh $(REMOTE)

SYNC_ITEMS = Makefile codegen scripts sql test tools generic_optimization_plan.md \
             third_party/metal-cpp third_party/nlohmann
RSYNC = rsync -avz --delete --exclude='.DS_Store' --exclude='*.bak' --exclude='*.bak2'

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
.PHONY: all rebuild clean run tools generic-only colbin-sf1 colbin-sf10 colbin-sf20 colbin-sf50 colbin-sf100 clean-colbin

all: $(TARGET)
tools: $(TBL2COLBIN)
generic-only: $(TARGET)
	@./scripts/run_generic_only.sh

rebuild: clean all

$(TARGET): $(CODEGEN_MAIN_OBJ) $(CODEGEN_LIB_OBJECTS) $(PG_QUERY_LIB) | $(BIN_DIR)
	@echo "Linking $(PROJECT_NAME)..."
	$(CXX) $(CODEGEN_MAIN_OBJ) $(CODEGEN_LIB_OBJECTS) $(PG_QUERY_LIB) $(FRAMEWORKS) -o $@
	@echo "Build complete: $@"

$(PG_QUERY_LIB):
	$(MAKE) -C $(PG_QUERY_DIR) libpg_query.a

$(OBJ_DIR)/codegen_codegen_main.o: $(CODEGEN_DIR)/codegen_main.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/codegen_%.o: $(CODEGEN_DIR)/%.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(TBL2COLBIN_OBJ): $(TBL2COLBIN_SRC) | $(OBJ_DIR)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(TBL2COLBIN): $(TBL2COLBIN_OBJ) $(INFRA_OBJ) | $(BIN_DIR)
	@echo "Linking tbl_to_colbin..."
	$(CXX) $(TBL2COLBIN_OBJ) $(INFRA_OBJ) $(FRAMEWORKS) -o $@
	@echo "Build complete: $@"

$(BIN_DIR) $(OBJ_DIR) $(BUILD_DIR):
	@mkdir -p $@

-include $(CODEGEN_MAIN_OBJ:.o=.d) $(CODEGEN_LIB_OBJECTS:.o=.d) $(TBL2COLBIN_OBJ:.o=.d)

clean:
	@echo "Cleaning build artifacts..."
	@rm -rf $(BUILD_DIR)
	@echo "Clean complete"

SF ?=
Q  ?=
run: all
	@./$(TARGET) $(SF) $(Q)

colbin-sf1: $(TBL2COLBIN)
	./$(TBL2COLBIN) data/SF-1

colbin-sf10: $(TBL2COLBIN)
	./$(TBL2COLBIN) data/SF-10

colbin-sf20: $(TBL2COLBIN)
	./$(TBL2COLBIN) data/SF-20

colbin-sf50: $(TBL2COLBIN)
	./$(TBL2COLBIN) data/SF-50

colbin-sf100: $(TBL2COLBIN)
	./$(TBL2COLBIN) data/SF-100

clean-colbin:
	@echo "Removing .colbin binaries under data/SF-*/..."
	@find data -maxdepth 2 -name '*.colbin' -print -delete 2>/dev/null || true
	@find data -maxdepth 2 -name '*.colbin.tmp' -print -delete 2>/dev/null || true

# ---------------------------------------------------------------------------
# Remote deployment
# ---------------------------------------------------------------------------
.PHONY: setup-remote sync sync-dry deploy remote-build remote-clean remote-check remote-run

setup-remote:
	@echo "Setting up remote directory..."
	$(SSH) 'mkdir -p $(REMOTE_PATH)'
	$(SSH) 'cd $(REMOTE_PATH) && ln -sfn /Users/nguyen/Documents/GPUDBMetalBenchmark/data data'
	@echo "Remote setup complete."

sync:
	@echo "Syncing project to $(REMOTE):$(REMOTE_PATH) ..."
	$(SSH) 'mkdir -p $(REMOTE_PATH)'
	$(RSYNC) $(SYNC_ITEMS) $(REMOTE):$(REMOTE_PATH)/
	$(SSH) 'cd $(REMOTE_PATH) && ln -sfn /Users/nguyen/Documents/GPUDBMetalBenchmark/data data'
	@echo "Sync complete."

sync-dry:
	@echo "Dry-run sync to $(REMOTE):$(REMOTE_PATH) ..."
	rsync -avzn --delete --exclude='.DS_Store' --exclude='*.bak' --exclude='*.bak2' $(SYNC_ITEMS) $(REMOTE):$(REMOTE_PATH)/ | head -80
	@echo "(dry-run; no files transferred)"

deploy: sync remote-build

remote-build:
	$(SSH) 'cd $(REMOTE_PATH) && test -f $(PG_QUERY_LIB) || make -C $(PG_QUERY_DIR) libpg_query.a'
	$(SSH) 'cd $(REMOTE_PATH) && make -j"$$(sysctl -n hw.ncpu 2>/dev/null || echo 8)"'

remote-clean:
	$(SSH) 'cd $(REMOTE_PATH) && make clean'

remote-check:
	$(SSH) 'cd $(REMOTE_PATH) && test -d codegen && test -f codegen/codegen_main.cpp && test -d third_party/metal-cpp && test -f $(PG_QUERY_LIB) && (test -d data || test -L data)'

remote-run: deploy
	$(SSH) 'cd $(REMOTE_PATH) && make run SF=$(SF) Q=$(Q)'

# ---------------------------------------------------------------------------
# Remote route gap benchmark
# ---------------------------------------------------------------------------
.PHONY: remote-gap-bench remote-gap-fetch

REMOTE_GAP_SF ?= sf1 sf10 sf100
BENCH_SF = $(if $(strip $(SF)),$(SF),$(REMOTE_GAP_SF))
WARMUP ?= 1
REPEAT ?= 3
REMOTE_GAP_DIR ?= build/route_gap_latest

remote-gap-bench: sync remote-build
	@echo "Running predefined+generic benchmark on remote (SF=$(BENCH_SF), warmup=$(WARMUP), repeat=$(REPEAT))..."
	$(SSH) 'cd $(REMOTE_PATH) && chmod +x scripts/run_route_gap_benchmark.sh && scripts/run_route_gap_benchmark.sh $(BENCH_SF) --warmup $(WARMUP) --repeat $(REPEAT) -o $(REMOTE_GAP_DIR)'
	@$(MAKE) -f Makefile.remote remote-gap-fetch

remote-gap-fetch:
	@mkdir -p build/remote
	@echo "Fetching remote gap benchmark into build/remote/route_gap_latest/ ..."
	rsync -avz --delete $(REMOTE):$(REMOTE_PATH)/$(REMOTE_GAP_DIR)/ build/remote/route_gap_latest/
	@echo "Fetched. See build/remote/route_gap_latest/gap_summary.csv"

.PHONY: help
help:
	@echo "Remote targets:"
	@echo "  make -f Makefile.remote sync"
	@echo "  make -f Makefile.remote deploy"
	@echo "  make -f Makefile.remote remote-run SF=sf1 Q=q6"
	@echo "  make -f Makefile.remote remote-gap-bench SF='sf1 sf10 sf100'"
